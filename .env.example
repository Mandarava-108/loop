# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — used by the recording cleanup cron (/api/cleanup-recordings).
# Never expose these to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY
CRON_SECRET=ANY-LONG-RANDOM-STRING
